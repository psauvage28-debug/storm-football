# URL publique du site (sans slash final) — utilisée pour canonical, sitemap, Open Graph
SITE_URL=https://www.storm-football.com
NODE_ENV=production

# Google Analytics 4 (chargé uniquement après consentement cookies). Laisser vide pour désactiver.
GA_ID=

# Envoi des messages du formulaire (côté serveur uniquement)
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=adresse, SMTP_PASS=mot de passe d'application
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=theobrugel.video@gmail.com
