<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand reveal">
      <div class="logo3d logo3d--small" data-logo3d="inview" aria-hidden="true">
        <div class="logo3d__stack">
          <% for (let i = 6; i >= 1; i--) { %><img class="logo3d__layer" style="--i:<%= i %>" src="/img/logo-storm.webp" alt="" width="720" height="720" loading="lazy"><% } %>
          <img class="logo3d__face" src="/img/logo-storm.webp" alt="" width="720" height="720" loading="lazy">
        </div>
      </div>
      <p><%= tr.footer.tagline %></p>
    </div>
    <nav class="footer__links" aria-label="<%= tr.footer.legal %>">
      <a href="<%= routes.services %>"><%= tr.nav.services %></a>
      <a href="<%= routes.work %>"><%= tr.nav.work %></a>
      <a href="<%= routes.contact %>"><%= tr.nav.contact %></a>
      <a href="<%= routes.legal %>"><%= tr.footer.legal %></a>
      <a href="<%= routes.privacy %>"><%= tr.footer.privacy %></a>
      <a href="<%= routes.terms %>"><%= tr.footer.terms %></a>
      <button type="button" class="linklike" data-cookie-open><%= tr.footer.cookies %></button>
    </nav>
    <div class="footer__social">
      <a href="<%= tr.contact.instagram %>" target="_blank" rel="noopener" aria-label="Instagram STORM">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 3.9 3.9 2.4 7.2 2.3 8.4 2.2 8.8 2.2 12 2.2zm0 4.7a5.1 5.1 0 1 0 0 10.2 5.1 5.1 0 0 0 0-10.2zm0 8.4a3.3 3.3 0 1 1 0-6.6 3.3 3.3 0 0 1 0 6.6zm5.3-9.8a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z"/></svg>
      </a>
      <a href="<%= tr.contact.linkedin %>" target="_blank" rel="noopener" aria-label="LinkedIn Théo Brugel">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.4v1.6h.1c.5-.9 1.6-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zm1.8 13.1H3.5V9h3.6v11.5zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z"/></svg>
      </a>
    </div>
    <p class="footer__copy">© <%= year %> STORM Football — Théo Brugel. <%= tr.footer.rights %></p>
  </div>
</footer>

<dialog class="gate" data-lang-gate aria-labelledby="gate-title">
  <div class="logo3d logo3d--gate" data-logo3d="spin" aria-hidden="true">
    <div class="logo3d__stack">
      <% for (let i = 6; i >= 1; i--) { %><img class="logo3d__layer" style="--i:<%= i %>" src="/img/logo-storm.webp" alt="" width="720" height="720"><% } %>
      <img class="logo3d__face" src="/img/logo-storm.webp" alt="" width="720" height="720">
    </div>
  </div>
  <p class="gate__title" id="gate-title"><%= tr.gate.title %></p>
  <p class="gate__sub"><%= tr.gate.sub %></p>
  <div class="gate__choices">
    <a class="gate__choice" href="<%= langUrls.fr %>" data-set-lang="fr" lang="fr" hreflang="fr"><span class="gate__code">FR</span> Français</a>
    <a class="gate__choice" href="<%= langUrls.en %>" data-set-lang="en" lang="en" hreflang="en"><span class="gate__code">EN</span> English</a>
  </div>
</dialog>

<div class="cookie" role="dialog" aria-live="polite" aria-labelledby="cookie-title" data-cookie hidden>
  <p class="cookie__title" id="cookie-title"><%= tr.cookies.title %></p>
  <p><%= tr.cookies.text %> <a href="<%= routes.privacy %>#cookies"><%= tr.cookies.more %></a></p>
  <div class="cookie__actions">
    <button type="button" class="btn btn--ghost" data-cookie-choice="refuse"><%= tr.cookies.refuse %></button>
    <button type="button" class="btn btn--ghost" data-cookie-choice="accept"><%= tr.cookies.accept %></button>
  </div>
</div>
</body>
</html>
