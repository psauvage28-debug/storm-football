<section class="band">
  <div class="container band__inner reveal">
    <img class="avatar avatar--lg" src="/img/theo-brugel-160.webp" srcset="/img/theo-brugel-160.webp 160w, /img/theo-brugel-320.webp 320w" sizes="88px" alt="Théo Brugel" width="160" height="160" loading="lazy">
    <div>
      <h2 class="h2 band__title"><%= tr.band.title %></h2>
      <p><%= tr.band.text %></p>
    </div>
    <a class="btn btn--cta" href="<%= routes.contact %>"><%= tr.cta %> <%- include('icon', { name: 'arrow' }) %></a>
  </div>
</section>
